{
  "name": "@dsh-external/dsh-file-drop", "version": "0.1.0", "private": true, "type": "module", "license": "MIT",
  "description": "Optional native file-drop routing and Conversation adapter for DeepSeek Harness",
  "main": "./lib/index.js", "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": [] } },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.0-rc <5" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2"
  },
  "dependencies": { "react": "^18.3.1", "react-dom": "^18.3.1" }
}
